# 슬랙 Incoming Webhook URL (필수 — 알림 받을 채널)
# https://api.slack.com/apps → Create New App → Incoming Webhooks 켜기 → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# 로컬 실행 시 자동 확인 간격(분). 기본 30
CHECK_INTERVAL_MINUTES=30
# 로컬 자동 확인을 끄려면 off
# LOCAL_SCHEDULER=off

# 일반 요청으로 판별이 안 될 때 설치된 Google Chrome으로 페이지를 렌더링해 재확인 (로컬 전용)
# 끄려면 off, 크롬 경로가 다르면 CHROME_PATH 지정
# BROWSER_FALLBACK=off
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── 배포(Vercel 등)할 때만 ──
# Postgres 연결 문자열 (Neon 무료 플랜 등). 비우면 data/items.json 파일에 저장
DATABASE_URL=
# 웹 접근 비밀번호 (비우면 로그인 없음)
APP_PASSWORD=
# 외부 크론이 /api/check 호출 시 쓰는 비밀값 → https://your-app/api/check?key=값
CRON_SECRET=
